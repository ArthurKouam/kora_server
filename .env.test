SESSION_DRIVER=memory
QUEUE_DRIVER=sync
LIMITER_STORE=memory

# Clé de hachage de test : sans elle, `verifyWebhookSignature` refuse toute
# signature et les tests de webhook ne peuvent rien vérifier. Valeur factice :
# elle ne sert qu'à calculer le HMAC localement, aucun appel réseau n'est fait.
NOTCHPAY_HASH_KEY=cle-de-test-notchpay
